    "/api/catalog/coverage": {
      "get": {
        "operationId": "catalog_coverage_api_catalog_coverage_get",
        "parameters": [
          {
            "in": "query",
            "name": "term",
            "required": true,
            "schema": {
              "pattern": "^\\d{4}(10|50|90)$",
              "title": "Term",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogCoverageResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Catalog Coverage",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/courses": {
