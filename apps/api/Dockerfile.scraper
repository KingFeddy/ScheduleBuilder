FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.8@sha256:3b7b60a81d3c57ef471703e5c83fd4aaa33abcd403596fb22ab07db85ae91347 /uv /uvx /bin/

ENV PLAYWRIGHT_BROWSERS_PATH=/app/playwright-browsers

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev

RUN uv run --no-sync playwright install-deps chromium
RUN uv run --no-sync playwright install chromium

COPY main.py ./
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY migrations/ ./migrations/
CMD ["uv", "run", "--no-sync", "python", "-m", "src.scrapers.cron"]
