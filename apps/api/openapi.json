      "post": {
        "description": "Stateless plan generation. Accepts a ParsedDegreeValidated (from /api/plan/parse)\nand student preferences, returns a semester-by-semester plan.\nNothing is stored server-side \u2014 the client persists the result to localStorage.",
        "operationId": "generate_degree_plan_api_plan_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneratedPlan"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
